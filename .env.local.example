# Trust x-forwarded-for/x-real-ip only when the production reverse proxy overwrites them.
# Set to 1 only when the deployment proxy overwrites forwarding headers. The
# app always enforces global in-process concurrency and rolling request caps;
# trusted client keys add per-client concurrency and rolling caps on top.
# The controlled hosted demo sets this to 1 only behind a proxy that overwrites
# forwarding headers. Local development leaves it at 0.
BYS_TRUST_PROXY_HEADERS=0

# Set to 0 to disable metadata-only analysis event logs.
BYS_ANALYSIS_EVENTS=1

# Optional AI-assisted analysis. Without a key, or when disabled, the app
# returns the complete deterministic report.
OPENAI_API_KEY=
BYS_AI_ENABLED=1
BYS_AI_TIMEOUT_MS=20000
