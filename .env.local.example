# AI API key (server-side only — use in Route Handlers / Server Actions; never NEXT_PUBLIC_*)
BYS_AI_KEY=
# Optional Gemini model id (server-side only). Defaults to gemini-2.5-flash if unset.
BYS_GEMINI_MODEL=gemini-2.5-flash
# Provider request timeout in milliseconds (server-side only).
BYS_AI_TIMEOUT_MS=20000
# Enable gated OCR adapter (0 = off, 1 = on). Requires a configured OCR provider.
BYS_OCR_ENABLED=0
# Enable async analysis jobs (0 = off, 1 = on). Gated — keep off unless latency gates require it.
BYS_ASYNC_ENABLED=0
# Enable optional expiring anonymous report recovery (0 = off, 1 = on).
BYS_RECOVERY_ENABLED=0
# Rollout: model contribution (0 = rules-only, 1 = allow model when key present).
BYS_MODEL_ENABLED=1
# Analysis pipeline version exposed in API responses.
BYS_ANALYSIS_VERSION=2
