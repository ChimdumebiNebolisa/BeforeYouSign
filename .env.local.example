# Primary analysis provider: openai or gemini. With no explicit value, OpenAI is selected when OPENAI_API_KEY exists.
BYS_ANALYSIS_PROVIDER=openai
# OpenAI text-analysis model (server-side only).
BYS_OPENAI_MODEL=gpt-5.6-luna
# Legacy Gemini key (server-side only; use in Route Handlers / Server Actions; never NEXT_PUBLIC_*).
BYS_AI_KEY=
# Optional legacy Gemini model id (server-side only). Defaults to gemini-2.5-flash if unset.
BYS_GEMINI_MODEL=gemini-2.5-flash
# Provider request timeout in milliseconds (server-side only).
BYS_AI_TIMEOUT_MS=20000
# Enable gated OCR adapter (0 = off, 1 = on). Requires a configured OCR provider.
BYS_OCR_ENABLED=0
# Rollout: model contribution (0 = rules-only, 1 = allow model when key is present).
BYS_MODEL_ENABLED=1

# OpenAI key for primary analysis, optional browser practice, and structured review.
OPENAI_API_KEY=
# Local operator access code for practice session and review endpoints. Never use a provider key here.
BYS_OPERATOR_TOKEN=
BYS_PRACTICE_ENABLED=0
BYS_PRACTICE_MODEL=gpt-realtime-2.1-mini
BYS_PRACTICE_MAX_SECONDS=180
BYS_REVIEW_PROVIDER=openai
BYS_REVIEW_MODEL=gpt-5.6-luna
